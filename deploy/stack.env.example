# Briefato stack environment — TEMPLATE and source of truth for the staging values.
# The values below are pushed to Portainer as the stack's `env` array by
# deploy/deploy-staging.sh (the compose interpolates them). Secrets (SECRET_KEY, FIELD_KEY,
# LLM_API_KEY, STRIPE_*) are filled in by the script and additionally stored in the vault:
#   pass show services/briefato

BRIEFATO_ENV=staging
BRIEFATO_BASE_URL=https://briefato.sabry.io
BRIEFATO_SECRET_KEY=
BRIEFATO_FIELD_KEY=
BRIEFATO_UI_LANG=de
BRIEFATO_ADMIN_EMAIL=mohamed@sabry.io
BRIEFATO_QUOTA_DEFAULT_LETTERS=10

# --- method brain (harvested Schreibdienst knowledge; packaged copies) ---
BRIEFATO_BRAIN_DIR=/srv/briefato/brain
BRIEFATO_MUSTERBRIEFE_DIR=/srv/briefato/brain/musterbriefe/templates

# --- model layer ---
# Staging runs with the mock provider (no patient data leaves the box).
# Production requires the DSGVO/AVV decision first — see docs/compliance/09-provider-dpa-briefing.md
BRIEFATO_LLM_MOCK=true
BRIEFATO_LLM_BASE_URL=https://api.mistral.ai/v1
BRIEFATO_LLM_API_KEY=
BRIEFATO_LLM_MODEL=mistral-large-latest
BRIEFATO_LLM_TIMEOUT_S=180
BRIEFATO_LLM_COST_IN_PER_1K=0
BRIEFATO_LLM_COST_OUT_PER_1K=0

# --- stripe (test mode until the compliance gate passes) ---
BRIEFATO_STRIPE_SECRET_KEY=
BRIEFATO_STRIPE_PUBLISHABLE_KEY=
BRIEFATO_STRIPE_WEBHOOK_SECRET=
BRIEFATO_STRIPE_PRICE_STARTER=
BRIEFATO_STRIPE_PRICE_PRAXIS=
BRIEFATO_STRIPE_PRICE_KLINIK=
